   "source": [
    "import cv2\n",
    "\n",
    "image =cv2.imread('images.jpeg')\n",
    "\n",
    "gray=cv2.cvtColor(image,cv2.COLOR_BGR2GRAY)\n",
    "\n",
    "edges=cv2.Canny(gray,100,200)\n",
    "cv2.imwrite('edges.jpg',edges)"
   ]
